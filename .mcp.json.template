{
  "mcpServers": {
    "obsidian": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "obsidian-mcp-server@latest"
      ],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "info",
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY:-qwerty}",
        "OBSIDIAN_BASE_URL": "${OBSIDIAN_BASE_URL:-http://127.0.0.1:27123}",
        "OBSIDIAN_OMNISEARCH_URL": "${OBSIDIAN_OMNISEARCH_URL:-http://localhost:51361}",
        "OBSIDIAN_ENABLE_COMMANDS": "${OBSIDIAN_ENABLE_COMMANDS:-true}"
      }
    },
    "nextcloud": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "nextcloud-mcp-server",
        "run",
        "--transport",
        "stdio"
      ],
      "env": {
        "NEXTCLOUD_HOST": "${NEXTCLOUD_HOST:-https://home.softmus.ru}",
        "NEXTCLOUD_USERNAME": "${NEXTCLOUD_USERNAME:-your_username}",
        "NEXTCLOUD_PASSWORD": "${NEXTCLOUD_PASSWORD:-your_app_password}"
      }
    },
    "outline": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-outline"
      ],
      "env": {
        "OUTLINE_API_KEY": "${OUTLINE_API_KEY:-your_api_key}",
        "OUTLINE_API_URL": "${OUTLINE_API_URL:-https://docs.softmus.ru/api}"
      }
    }
  }
}
