# Единые переводы строк в репозитории: текст нормализуется к LF,
# чтобы команда на macOS / Windows / Linux не плодила CRLF-диффы.
* text=auto eol=lf

# Текстовые форматы хранилища (markdown + конфиги/представления Obsidian).
# .canvas — JSON Canvas, .base — YAML Bases: оба обычный текст.
*.md       text
*.markdown text
*.json     text
*.canvas   text
*.base     text
*.yml      text
*.yaml     text
*.css      text
*.txt      text

# Вложения (_files/) — бинарные: без попыток diff/merge.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.bmp   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.zip   binary
*.mp3   binary
*.wav   binary
*.m4a   binary
*.mp4   binary
*.mov   binary
*.webm  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# ── Свои скрипты (Python / TypeScript) ──
# Исходники (.py/.ts/.js/.sh) уже получают LF от глобального правила выше.
# Понятные заголовки hunk'ов в диффах Python:
*.py diff=python
# Windows-скрипты требуют CRLF, иначе ломается выполнение:
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Лок-файлы — генерируемые: не диффим и не учитываем в статистике языков.
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml    linguist-generated=true -diff
yarn.lock         linguist-generated=true -diff
poetry.lock       linguist-generated=true -diff
uv.lock           linguist-generated=true -diff
